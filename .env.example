# Groq API key (required) — get one at https://console.groq.com
GROQ_API_KEY=gsk_...

# Deepgram API key (required) — get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Groq model (optional, default: llama-3.3-70b-versatile)
# LLM_MODEL=llama-3.3-70b-versatile

# Deepgram Aura TTS voice (optional, default: aura-2-asteria-en)
# TTS_VOICE=aura-2-asteria-en
